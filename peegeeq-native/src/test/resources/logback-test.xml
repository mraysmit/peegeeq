<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="vxTrace" 
                    class="dev.mars.peegeeq.api.logging.VertxTraceIdConverter" />
    <conversionRule conversionWord="vxSpan" 
                    class="dev.mars.peegeeq.api.logging.VertxSpanIdConverter" />

    <!-- Test-specific console appender with simplified pattern -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [trace=%vxTrace span=%vxSpan] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger for tests - INFO level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- PeeGeeQ Native specific loggers -->
    <logger name="dev.mars.peegeeq.pgqueue" level="WARN" />

    <!--
    DEBUG LOGGING CONTROL FOR NATIVE QUEUE COMPONENTS
    =================================================

    The following loggers control detailed debug output for native queue operations:

    - PgNativeQueueConsumer: Consumer subscription, message processing, LISTEN/NOTIFY
    - PgNativeQueueFactory: Factory creation and consumer instantiation
    - PgQueueFactoryProvider: Factory registration and provider initialization
    - NativeQueueIntegrationTest: Test-specific debug output

    Set level to:
    - DEBUG: Show detailed debug logs with NATIVE-DEBUG/FACTORY-DEBUG prefixes
    - INFO:  Hide debug logs, show only standard INFO/WARN/ERROR messages
    -->
    <logger name="dev.mars.peegeeq.pgqueue.PgNativeQueueConsumer" level="DEBUG" />
    <logger name="dev.mars.peegeeq.pgqueue.PgNativeQueueFactory" level="DEBUG" />
    <logger name="dev.mars.peegeeq.db.provider.PgQueueFactoryProvider" level="DEBUG" />
    <logger name="dev.mars.peegeeq.pgqueue.NativeQueueIntegrationTest" level="DEBUG" />

    
    <!-- Reduce TestContainers noise -->
    <logger name="org.testcontainers" level="WARN" />
    <logger name="com.github.dockerjava" level="WARN" />
    <logger name="tc" level="WARN" />

    <!-- Suppress noisy duplicate-object warnings from idempotent Flyway migrations. -->
    <logger name="org.flywaydb.core.internal.sqlscript.DefaultSqlScriptExecutor" level="ERROR" />

    <!-- Suppress PostgreSQL NOTICE messages (42P06 schema already exists, 42P07 relation already exists)
         which Vert.x SQL client promotes to WARN. These are expected from IF NOT EXISTS DDL. -->
    <logger name="io.vertx.sqlclient.impl.SocketConnectionBase" level="ERROR" />
    
    <!-- Reduce Vert.x noise -->
    <logger name="io.vertx" level="WARN" />
    
    <!-- Reduce Hikari connection pool noise -->
    <logger name="com.zaxxer.hikari" level="WARN" />

    <!-- Finding 17: no production logger is switched off or detached from the root logger.
         The unexpected-ERROR check listens on the root logger only, so a detached or OFF logger
         hides its ERROR lines from every test. A test that causes an ERROR declares it with
         @ExpectedErrorLog. -->
</configuration>

