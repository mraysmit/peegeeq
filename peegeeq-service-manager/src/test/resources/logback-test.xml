<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Test logging configuration for PeeGeeQ Service Manager module -->
    <conversionRule conversionWord="vxTrace" 
                    class="dev.mars.peegeeq.api.logging.VertxTraceIdConverter" />
    <conversionRule conversionWord="vxSpan" 
                    class="dev.mars.peegeeq.api.logging.VertxSpanIdConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [trace=%vxTrace span=%vxSpan] %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- PeeGeeQ Service Manager specific loggers -->
    <logger name="dev.mars.peegeeq.servicemanager" level="INFO" />
    <logger name="dev.mars.peegeeq" level="WARN" />
    
    <!-- Finding 17: no production logger is detached from the root logger. The unexpected-ERROR
         check listens on the root logger only. A test that causes an ERROR declares it with
         @ExpectedErrorLog. -->
    
    <!-- Reduce TestContainers noise -->
    <logger name="org.testcontainers" level="WARN" />
    <logger name="com.github.dockerjava" level="WARN" />
    <logger name="tc" level="WARN" />

    <!-- Suppress noisy duplicate-object warnings from idempotent Flyway migrations. -->
    <logger name="org.flywaydb.core.internal.sqlscript.DefaultSqlScriptExecutor" level="ERROR" />
    
    <!-- Reduce Vert.x noise -->
    <logger name="io.vertx" level="WARN" />
    
    <!-- Reduce Hikari connection pool noise -->
    <logger name="com.zaxxer.hikari" level="WARN" />
</configuration>

