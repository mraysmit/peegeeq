<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.mars</groupId>
    <artifactId>peegeeq</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PeeGeeQ</name>
    <description>PostgreSQL Message Queue</description>
    <url>https://github.com/mraysmityour-repo/peegeeq</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Mark Andrew Ray-Smith</name>
            <organization>Cityline Ltd</organization>
            <organizationUrl>https://cityline.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/your-repo/peegeeq.git</connection>
        <developerConnection>scm:git:https://github.com/mraysmityour-repo/peegeeq.git</developerConnection>
        <url>https://github.com/mraysmit/peegeeq</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>ossrh</id>
            <name>Central Repository OSSRH</name>
            <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
        <snapshotRepository>
            <id>ossrh</id>
            <name>Central Repository OSSRH</name>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <modules>
        <module>peegeeq-api</module>
        <module>peegeeq-outbox</module>
        <module>peegeeq-db</module>
        <module>peegeeq-native</module>
        <module>peegeeq-bitemporal</module>
        <module>peegeeq-runtime</module>
        <module>peegeeq-rest</module>
        <module>peegeeq-rest-client</module>
        <module>peegeeq-service-manager</module>
        <module>peegeeq-pg-sidecar</module>
        <module>peegeeq-pg-failover</module>
        <module>peegeeq-test-support</module>
        <module>peegeeq-examples</module>
        <module>peegeeq-benchmarking</module>
        <module>peegeeq-migrations</module>
        <module>peegeeq-openapi</module>
        <module>peegeeq-integration-tests</module>
        <module>peegeeq-coverage-report</module>
        <module>peegeeq-management-ui</module>
        <module>peegeeq-utilities-ui</module>
    </modules>

    <properties>
        <!-- The one Java version for the reactor: compiler release, toolchain JDK and javadoc source. -->
        <maven.compiler.release>27</maven.compiler.release>
        <!-- JaCoCo coverage is OFF by default; opt in with -Pcoverage (or -Djacoco.skip=false) -->
        <jacoco.skip>true</jacoco.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vertx.version>5.1.10</vertx.version>
        <!-- One surefire/failsafe version for every module. 3.5.3 fixed SUREFIRE-1643: with JUnit
             parallel execution, 3.2.5 filed test cases and counts under the wrong class. -->
        <surefire.version>3.5.6</surefire.version>
        <postgresql.version>42.7.4</postgresql.version>
        <!-- No Jackson version here: the Vert.x BOM imports jackson-bom, so every Jackson artifact
             resolves to the one version Vert.x is built against. -->
        <junit.version>5.12.2</junit.version>
        <testcontainers.version>2.0.2</testcontainers.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.5.18</logback.version>
        <micrometer.version>1.12.0</micrometer.version>
        <resilience4j.version>2.1.0</resilience4j.version>
        <!-- Must equal the scram-client version vertx-pg-client declares (5.1.10 declares 3.2). -->
        <scram.version>3.2</scram.version>
        <flyway.version>11.7.2</flyway.version>
        <h2.version>2.3.232</h2.version>

        <!--
          Single source of truth for Surefire/Failsafe JUnit 5 tag filtering.
          Every module pom binds <groups>${test.groups}</groups> and
          <excludedGroups>${test.excludedGroups}</excludedGroups> in its surefire
          plugin config and inherits these defaults from here. Override them by
          activating one of the root-level test profiles (integration-tests,
          performance-tests, smoke-tests, all-tests). No module pom should
          redefine these — duplicating them per module silently overrides
          -P… activations and causes untagged tests to be excluded.
        -->
        <test.groups>core</test.groups>
        <test.excludedGroups>integration,performance,slow</test.excludedGroups>
        <test.parallel>methods</test.parallel>
        <test.threadCount>4</test.threadCount>
        <!--
          Timeout defaults are passed to JUnit Jupiter via surefire as
          configurationParameters (junit.jupiter.execution.timeout.*). They MUST
          be valid JUnit duration strings (e.g. "30s", "5m"). If left unset,
          JUnit logs a DateTimeParseException for the literal "${test.timeout.*}"
          token. Override per-profile (integration-tests, performance-tests, etc.).
        -->
        <test.timeout.default>30s</test.timeout.default>
        <test.timeout.method>10s</test.timeout.method>
        <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
        <peegeeq.performance.tests>false</peegeeq.performance.tests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Module Dependencies -->
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-native</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-bitemporal</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-service-manager</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.mars</groupId>
                <artifactId>peegeeq-benchmarking</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- PostgreSQL Driver -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
                <exclusions>
                    <!-- Exclude the old SCRAM 2.x artifacts; scram-client ${scram.version} below is the
                         version vertx-pg-client uses -->
                    <exclusion>
                        <groupId>com.ongres.scram</groupId>
                        <artifactId>client</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.ongres.scram</groupId>
                        <artifactId>common</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- SCRAM Authentication for PostgreSQL -->
            <!-- Note: These are transitively provided by vertx-pg-client -->
            <!-- Managed here for version consistency across all modules -->
            <dependency>
                <groupId>com.ongres.scram</groupId>
                <artifactId>scram-client</artifactId>
                <version>${scram.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ongres.scram</groupId>
                <artifactId>scram-common</artifactId>
                <version>${scram.version}</version>
            </dependency>

            <!-- Vert.x 5.x BOM. It also imports jackson-bom, which sets the Jackson version. -->
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-dependencies</artifactId>
                <version>${vertx.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JUnit 5 BOM — manages jupiter/params/api/engine and the platform consistently
                 (formerly supplied via the Spring Boot BOM). Keeps the platform launcher/engine in lockstep
                 with jupiter, which JUnit tag-filtering depends on. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers 2.x. The 1.x artifact names (junit-jupiter, postgresql, consul, jdbc,
                 database-commons) are banned by the enforcer rule above. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-postgresql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-consul</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-jdbc</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-database-commons</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- NOTE: The Spring Boot BOM is intentionally NOT imported here. Spring is an
                 integration-example concern only (peegeeq-examples-spring, a standalone project) and
                 must never manage versions for the core reactor. Do not re-add it. -->

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Metrics and Monitoring -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>${micrometer.version}</version>
            </dependency>


            <!-- Resilience -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-ratelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Flyway: used by peegeeq-migrations and by peegeeq-test-support. One version for both. -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <!-- H2: the benchmark history store in peegeeq-benchmarking, never a PostgreSQL substitute. -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>toolchain</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <toolchains>
                            <jdk>
                                <version>${maven.compiler.release}</version>
                            </jdk>
                        </toolchains>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.4.1</version>
                    <executions>
                        <execution>
                            <id>enforce-maven-version</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>[3.8.0,)</version>
                                        <message>Maven 3.8.0 or higher is required.</message>
                                    </requireMavenVersion>
                                    <!-- Testcontainers 2.x renamed every module artifact. A 1.x artifact on the
                                         classpath runs 1.x module code on the 2.x core, and the 1.x postgresql
                                         module duplicates classes of testcontainers-postgresql. Use the
                                         testcontainers-* names that this pom manages. -->
                                    <bannedDependencies>
                                        <excludes>
                                            <exclude>org.testcontainers:junit-jupiter</exclude>
                                            <exclude>org.testcontainers:consul</exclude>
                                            <exclude>org.testcontainers:postgresql</exclude>
                                            <exclude>org.testcontainers:jdbc</exclude>
                                            <exclude>org.testcontainers:database-commons</exclude>
                                            <exclude>org.testcontainers:testcontainers:[,2.0.0)</exclude>
                                        </excludes>
                                        <message>A Testcontainers 1.x artifact is on the classpath. Use the testcontainers-* 2.x artifact that the root pom manages.</message>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!-- The surefire defaults plus *IT: no module binds failsafe, so without the
                             last pattern the *IT classes ran in no build. -->
                        <includes>
                            <include>**/Test*.java</include>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*TestCase.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                        <systemPropertyVariables>
                            <junit.jupiter.extensions.autodetection.enabled>${junit.jupiter.extensions.autodetection.enabled}</junit.jupiter.extensions.autodetection.enabled>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <!-- 0.8.14 rejects Java 27 class files ("Unsupported class file major version 71"). -->
                    <version>0.8.15</version>
                    <configuration>
                        <skip>${jacoco.skip}</skip>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.0.1</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>release</releaseProfiles>
                        <goals>deploy</goals>
                        <preparationGoals>clean verify</preparationGoals>
                        <completionGoals>clean</completionGoals>
                        <checkModificationExcludes>
                            <checkModificationExclude>pom.xml</checkModificationExclude>
                        </checkModificationExcludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <source>${maven.compiler.release}</source>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <quiet>true</quiet>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Compile and fork tests on the JDK that ~/.m2/toolchains.xml registers for
                 ${maven.compiler.release}. The build fails when no such entry exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
            </plugin>
            <!-- Enforce the minimum Maven version. The toolchain above enforces the JDK. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Test-execution profiles. These are the SINGLE SOURCE OF TRUTH for
          JUnit 5 tag filtering across every module. Activating one of these
          profiles overrides the default properties declared above.

          Default (no -P flag):  test.groups=core, excludedGroups=integration,performance,slow
            mvn test                    -> runs @Tag("core") only
            mvn test -Pintegration-tests-> runs @Tag("integration")
            mvn test -Pperformance-tests-> runs @Tag("performance"); performance flag on
            mvn test -Psmoke-tests      -> runs @Tag("smoke")
            mvn test -Pall-tests        -> runs EVERY test (tagged and untagged, every module)
            mvn test -Puntagged-tests   -> safety net: runs only tests with NO known tag
        -->

        <!-- Code Coverage - JaCoCo is OFF by default (jacoco.skip=true); enable with -Pcoverage -->
        <profile>
            <id>coverage</id>
            <properties>
                <jacoco.skip>false</jacoco.skip>
            </properties>
        </profile>

        <!-- Integration Tests - With real infrastructure (Testcontainers) -->
        <profile>
            <id>integration-tests</id>
            <properties>
                <test.groups>integration</test.groups>
                <test.excludedGroups>performance,slow</test.excludedGroups>
                <test.parallel>classes</test.parallel>
                <test.threadCount>2</test.threadCount>
                <test.timeout.default>5m</test.timeout.default>
                <test.timeout.method>3m</test.timeout.method>
            </properties>
        </profile>

        <!-- Performance Tests - Load and throughput -->
        <profile>
            <id>performance-tests</id>
            <properties>
                <test.groups>performance</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <test.parallel>none</test.parallel>
                <test.threadCount>1</test.threadCount>
                <test.timeout.default>15m</test.timeout.default>
                <test.timeout.method>10m</test.timeout.method>
                <peegeeq.performance.tests>true</peegeeq.performance.tests>
            </properties>
        </profile>

        <!-- Smoke Tests - Ultra-fast basic verification -->
        <profile>
            <id>smoke-tests</id>
            <properties>
                <test.groups>smoke</test.groups>
                <test.excludedGroups>integration,performance,slow</test.excludedGroups>
                <test.parallel>methods</test.parallel>
                <test.threadCount>8</test.threadCount>
                <test.timeout.default>30s</test.timeout.default>
                <test.timeout.method>10s</test.timeout.method>
            </properties>
        </profile>

        <!--
          ALL TESTS - the single profile that runs every test in every module,
          tagged or untagged. This is the regression-safety profile: any test
          that exists in the repo will execute under this profile. Use this
          in CI for full coverage, and locally before merging significant
          changes. It must NEVER silently exclude a test.
        -->
        <profile>
            <id>all-tests</id>
            <properties>
                <test.groups></test.groups>
                <test.excludedGroups></test.excludedGroups>
                <test.parallel>classes</test.parallel>
                <test.threadCount>2</test.threadCount>
                <test.timeout.default>30m</test.timeout.default>
                <test.timeout.method>15m</test.timeout.method>
                <peegeeq.performance.tests>true</peegeeq.performance.tests>
            </properties>
        </profile>

        <!--
          UNTAGGED TESTS - safety-net audit profile. Runs only tests that
          carry none of the known tags. If this profile reports any test
          executions, those tests are missing a @Tag annotation and need
          to be classified.
        -->
        <profile>
            <id>untagged-tests</id>
            <properties>
                <test.groups></test.groups>
                <test.excludedGroups>core,integration,performance,slow,smoke</test.excludedGroups>
                <test.parallel>classes</test.parallel>
                <test.threadCount>2</test.threadCount>
                <test.timeout.default>5m</test.timeout.default>
                <test.timeout.method>3m</test.timeout.method>
            </properties>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
